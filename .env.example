# Public application URL. On Vercel this is the assigned *.vercel.app URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB is server-only. Vercel's integration supplies MONGODB_URI in preview and production.
# The optional database and collection names keep the auth data isolated from products and orders.
MONGODB_URI=
MONGODB_DB=
MONGODB_PRODUCTS_COLLECTION=products
MONGODB_ORDERS_COLLECTION=orders
MONGODB_USERS_COLLECTION=users
MONGODB_AUTH_SESSIONS_COLLECTION=auth_sessions
MONGODB_AUTH_TOKENS_COLLECTION=auth_tokens
MONGODB_AUTH_RATE_LIMITS_COLLECTION=auth_rate_limits

# The verified account that matches this private value receives the only admin role.
ADMIN_EMAIL=duena@tu-dominio.com

# Transactional email is required for account confirmation and password recovery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ventas@tu-dominio.com

# Ably is server-only; browsers receive short-lived capability-limited tokens.
ABLY_API_KEY=

# Mock payment webhook signing secret. Replace with a provider-specific secret later.
MOCK_PAYMENT_WEBHOOK_SECRET=change-me-in-vercel

# Optional rate-limit integration prepared for later phases.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
